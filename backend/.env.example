# Copia este archivo como .env (NUNCA subas el .env a GitHub)

# Clave de API de DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Panel administrativo (/admin): contraseña del docente
ADMIN_PASSWORD=cambia-esta-contraseña-larga

# Clave para firmar las sesiones de los equipos y del panel (larga y aleatoria; si la cambias, todos deben volver a ingresar)
SECRET_KEY=genera-una-clave-aleatoria-de-al-menos-32-caracteres

# Token para consultar la API docente desde scripts (opcional)
TEACHER_TOKEN=otro-token-largo-y-secreto

# Solo los equipos registrados (código + correo) pueden usar el Tutor IA
REQUIRE_TEAM_LOGIN=1

# Origen del frontend en GitHub Pages (sin barra final). Separa varios con comas.
ALLOWED_ORIGINS=https://tuusuario.github.io

# En PythonAnywhere (HTTPS) déjalo en 1; para pruebas locales sin HTTPS usa 0
SESSION_COOKIE_SECURE=1

# Límites (por equipo y por hora)
RATE_LIMIT_PER_HOUR=15
MAX_INPUT_CHARS=24000

# Mentor IA: consultas a la IA (pistas generadas y revisiones) por equipo y por hora
MENTOR_RATE_PER_HOUR=40
